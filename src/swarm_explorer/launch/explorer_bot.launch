<launch>
  <arg name="robot_id" default="1"/>
  <!-- config selects which param-set YAML files to load (e.g. 3bot, 5bot). -->
  <arg name="config"   default="3bot"/>

  <group ns="robot_$(arg robot_id)">
    <node pkg="swarm_explorer" type="explorer_bot.py"
        name="explorer_bot" output="screen">
      <param name="robot_id" value="$(arg robot_id)"/>

      <!-- Load mapping params (grid dimensions, update probabilities, downsample). -->
      <rosparam command="load"
                file="$(eval find('swarm_explorer') + '/config/mapping_params_' + arg('config') + '.yaml')"/>

      <!-- Load explorer behaviour params (escape, frontier, visualization). -->
      <rosparam command="load"
                file="$(eval find('swarm_explorer') + '/config/explorer_params_' + arg('config') + '.yaml')"/>

      <!-- Per-robot topic/frame overrides (cannot live in a shared YAML). -->
      <param name="topics/sensor" value="/robot_$(arg robot_id)/scan"/>
      <param name="topics/vis"    value="/robot_$(arg robot_id)/vis/explorer_map"/>
      <param name="frames/sensor" value="robot_$(arg robot_id)/base_scan"/>
      <param name="frames/fixed"  value="map"/>
    </node>
  </group>
</launch>
