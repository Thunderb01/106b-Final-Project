<launch>
  <!-- Use sim time -->
  <param name="use_sim_time" value="true"/>
  <param name="/use_sim_time" value="true"/>

  <!-- Launch RViz with the swarm configuration -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find swarm_explorer)/config/swarm_w_occupancy_grid.rviz">
    <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
    <env name="QT_XCB_FORCE_SOFTWARE_OPENGL" value="1"/>
  </node>
</launch> 