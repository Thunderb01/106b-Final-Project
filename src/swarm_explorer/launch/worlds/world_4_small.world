<sdf version='1.7'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name='small_plaza'>
      <static>1</static>

      <!-- Outer boundary: roughly 14m x 14m -->
      <link name='wall_west'>
        <pose>-7 0 0 0 0 1.5708</pose>
        <collision name='collision'>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name='wall_east'>
        <pose>7 0 0 0 0 1.5708</pose>
        <collision name='collision'>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name='wall_north'>
        <pose>0 7 0 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name='wall_south'>
        <pose>0 -7 0 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>14 0.15 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <!-- A couple of smaller internal obstacles -->
      <link name='center_bar'>
        <pose>-0.8 0.8 0 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>4.0 0.18 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>4.0 0.18 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <link name='south_vertical'>
        <pose>2.2 -2.4 0 0 0 1.5708</pose>
        <collision name='collision'>
          <geometry><box><size>3.3 0.18 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>3.3 0.18 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <!-- Large corner block obstacle -->
      <link name='corner_block_sw'>
        <pose>-3.8 -3.8 0 0 0 0</pose>
        <collision name='collision'>
          <geometry><box><size>3.8 3.8 0.8</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.4 0 0 0</pose>
          <geometry><box><size>3.8 3.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>

      <!-- Opposite-corner corridor wall forming a 1.0 m corridor to the east wall -->
      <link name='corner_corridor_ne'>
        <!-- Long side parallel to east boundary (x = 7), short side flush at the top.
             Approx 1.0 m gap between this wall and the east perimeter wall. -->
        <pose>5.9 4.925 0 0 0 1.5708</pose>
        <collision name='collision'>
          <geometry><box><size>4.0 0.18 0.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>4.0 0.18 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-10 12 9 0 0.55 -1.0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
